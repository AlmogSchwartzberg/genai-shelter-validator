# Copy to .env (git-ignored) and fill in. In Colab put .env in the Drive folder (drive_root); locally in the repo root.
OPENAI_API_KEY=
# Roboflow (optional): the project must already exist in the Roboflow UI; a free plan makes it public.
ROBOFLOW_API_KEY=
# Slugs from the project URL: app.roboflow.com/<workspace>/<project>. The values below are guesses from the display names, check them.
ROBOFLOW_WORKSPACE=fancygs-workspace
ROBOFLOW_PROJECT=bounding-boxes-genai
